generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

enum PolicyTemplate {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
  CUSTOM
}

enum MerchantReputation {
  TRUSTED
  UNKNOWN
  BLOCKED
}

enum TransactionDecision {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

enum AlertType {
  TRANSACTION_BLOCKED
  BUDGET_THRESHOLD
  SUSPICIOUS_BURST
  UNKNOWN_MERCHANT
  PROMPT_INJECTION_DETECTED
  KILL_SWITCH_ACTIVATED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalConfig {
  id                String   @id @default("global")
  killSwitchActive  Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model Policy {
  id                     String          @id @default(cuid())
  name                   String
  template               PolicyTemplate  @default(CUSTOM)
  enabled                Boolean         @default(true)
  perTxLimitUsd          Float
  dailyBudgetUsd         Float
  monthlyBudgetUsd       Float
  maxTxPerHour           Int
  maxTxPerDay            Int
  approvalThresholdScore Int
  denyThresholdScore     Int
  allowedHoursStart      String?
  allowedHoursEnd        String?
  blockUnknownMerchants  Boolean         @default(true)
  allowedCategories      Json?
  blockedCategories      Json?
  agents                 Agent[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model Agent {
  id               String        @id @default(cuid())
  name             String        @unique
  description      String?
  status           AgentStatus   @default(ACTIVE)
  killSwitchActive Boolean       @default(false)
  trustScore       Int           @default(100)
  policyId         String
  policy           Policy        @relation(fields: [policyId], references: [id])
  lastActiveAt     DateTime?
  totalSpent       Float         @default(0)
  totalTx          Int           @default(0)
  apiKeys          ApiKey[]
  transactions     Transaction[]
  approvals        Approval[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
}

model ApiKey {
  id         String   @id @default(cuid())
  keyHash    String   @unique
  keyPrefix  String
  name       String
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([agentId])
}

model Merchant {
  id         String               @id @default(cuid())
  name       String
  domain     String               @unique
  category   String
  reputation MerchantReputation   @default(UNKNOWN)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model Transaction {
  id              String                @id @default(cuid())
  agentId         String
  agent           Agent                 @relation(fields: [agentId], references: [id])
  merchantDomain  String
  merchantName    String?
  amountUsd       Float
  currency        String                @default("USDC")
  purpose         String?
  idempotencyKey  String
  decision        TransactionDecision
  riskScore       Int
  reasonCodes     Json
  policyChecks    Json
  riskBreakdown   Json
  x402TxHash      String?
  createdAt       DateTime              @default(now())
  approval        Approval?
  auditLog        AuditLog?

  @@index([agentId])
  @@index([decision])
  @@index([createdAt])
}

model Approval {
  id            String          @id @default(cuid())
  transactionId String          @unique
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent           @relation(fields: [agentId], references: [id])
  status        ApprovalStatus  @default(PENDING)
  reason        String
  note          String?
  decidedAt     DateTime?
  expiresAt     DateTime
  createdAt     DateTime        @default(now())

  @@index([status])
}

model AuditLog {
  id            String       @id @default(cuid())
  transactionId String       @unique
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  payloadHash   String
  prevHash      String?
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

model Alert {
  id            String         @id @default(cuid())
  type          AlertType
  severity      AlertSeverity
  title         String
  description   String
  agentId       String?
  isRead        Boolean        @default(false)
  isDismissed   Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@index([severity])
  @@index([isDismissed])
  @@index([createdAt])
}