# Where the gateway lives
POLICYPAY_URL=https://policypay-production.up.railway.app

# The everyday agent — small purchases
POLICYPAY_API_KEY=pp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLICYPAY_AGENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxx

# A second agent with a higher cap, for big-ticket buys.
# This is what makes the third purchase escalate to a human
# instead of being refused outright.
POLICYPAY_PROCUREMENT_KEY=pp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLICYPAY_PROCUREMENT_AGENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — lets the agent wait live while you click Approve
# on the dashboard. Without these it just prints the approval id.
POLICYPAY_DASHBOARD_EMAIL=admin@policypay.demo
POLICYPAY_DASHBOARD_PASSWORD=Demo1234!
